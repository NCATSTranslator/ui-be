{
  "/api/v1/users/me/canvas": {
    "get": {
      "summary": "Get all canvases for the current user",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "include_deleted",
          "in": "query",
          "schema": {
            "type": "boolean",
            "default": false
          },
          "description": "Controls if the response should include canvases that are soft deleted"
        }
      ],
      "responses": {
        "200": {
          "description": "All the canvases associated with the current user",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "../schemas/canvas.json#/UserCanvas"
                }
              }
            }
          }
        },
        "400": {
          "description": "Bad Request",
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    },
    "post": {
      "summary": "Create a canvas for the current user",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/canvas.json#/CreateCanvasRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Canvas successfully created",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/UserCanvas"
              }
            }
          }
        },
        "400": {
          "description": "Initial canvas graph is malformed"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/{save_id}": {
    "put": {
      "summary": "Update properties of a canvas for the current user",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/canvas.json#/UpdateCanvasRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Canvas successfully updated",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/UserCanvas"
              }
            }
          }
        },
        "400": {
          "description": "The update request is malformed"
        },
        "404": {
          "description": "The Canvas does not exist"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/trash": {
    "put": {
      "summary": "Trash a list of Canvas Save IDs for the current User",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Canvases trashed successfully"
        },
        "400": {
          "description": "The request body is not a valid array of canvas IDs"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/restore": {
    "put": {
      "summary": "Restore a list of Canvas Save IDs for the current User",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Canvases restored successfully"
        },
        "400": {
          "description": "The request body is not a valid array of canvas IDs"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/{save_id}/graph": {
    "get": {
      "summary": "Get the Nodes, Edges, and Tags for a Canvas",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        },
        {
          "name": "include_deleted",
          "in": "query",
          "schema": {
            "type": "boolean",
            "default": false
          },
          "description": "Controls if the response should include soft deleted nodes, edges, and canvases"
        }
      ],
      "responses": {
        "200": {
          "description": "Graph data retrieved successfully",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/CanvasGraph"
              }
            }
          }
        },
        "404": {
          "description": "The Canvas does not exist"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    },
    "post": {
      "summary": "Submit a graph to merge into a Canvas",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/canvas.json#/Graph"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The resulting Canvas graph after the merge",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/CanvasGraph"
              }
            }
          }
        },
        "400": {
          "description": "The submitted graph is malformed"
        },
        "404": {
          "description": "The Canvas does not exist"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/{save_id}/graph/trash": {
    "put": {
      "summary": "Soft delete Nodes and Edges from a Canvas",
      "description": "Soft deletes the listed Canvas Nodes, Edges and Annotations in a single atomic operation. Soft deleting a node also soft deletes every edge attached to it; annotations are independent and cascade to nothing. Returns the resulting Canvas graph.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/canvas.json#/GraphSelection"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The resulting Canvas graph after the soft delete",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/CanvasGraph"
              }
            }
          }
        },
        "400": {
          "description": "The request body is not a valid selection of node and edge ids"
        },
        "404": {
          "description": "The Canvas does not exist"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/{save_id}/graph/restore": {
    "put": {
      "summary": "Restore soft deleted Nodes and Edges in a Canvas",
      "description": "Restores the listed Canvas Nodes, Edges and Annotations in a single atomic operation. An edge is only restored if both of its endpoint nodes are active; annotations restore unconditionally. Returns the resulting Canvas graph.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/canvas.json#/GraphSelection"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The resulting Canvas graph after the restore",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/CanvasGraph"
              }
            }
          }
        },
        "400": {
          "description": "The request body is not a valid selection of node and edge ids"
        },
        "404": {
          "description": "The Canvas does not exist"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/{save_id}/graph/geometry": {
    "put": {
      "summary": "Place Nodes and Annotations on a Canvas",
      "description": "Updates the (x, y) positions of the given Canvas Nodes and the full rectangles (x, y, width, height) of the given Canvas Annotations in a single atomic operation. Both collections are optional but at least one must be non-empty. Only active (non-deleted) elements on the Canvas are updated. Returns the elements that were actually updated.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/canvas.json#/GraphGeometry"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The Canvas Nodes and Canvas Annotations that were updated",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/CanvasGeometry"
              }
            }
          }
        },
        "400": {
          "description": "The request body is not a valid set of node positions and annotation rectangles"
        },
        "404": {
          "description": "The Canvas does not exist"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/{save_id}/annotation": {
    "post": {
      "summary": "Create an Annotation on a Canvas",
      "description": "Creates a Canvas Annotation with the given text and rectangle. Content, x, y, width and height are all required; null is not accepted for any of them. Position and size are changed afterwards through the graph geometry endpoint, and the text through the annotation update endpoint.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/canvas.json#/CreateAnnotationRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The created Canvas Annotation",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/CanvasAnnotation"
              }
            }
          }
        },
        "400": {
          "description": "The annotation request is malformed"
        },
        "404": {
          "description": "The Canvas does not exist"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/{save_id}/annotation/{annotation_id}": {
    "put": {
      "summary": "Update the text of a Canvas Annotation",
      "description": "Replaces a Canvas Annotation's content. Position and size are updated through the graph geometry endpoint, not here. Returns the updated Canvas Annotation.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        },
        {
          "name": "annotation_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Annotation ID"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/canvas.json#/UpdateAnnotationContentRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The updated Canvas Annotation",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/CanvasAnnotation"
              }
            }
          }
        },
        "400": {
          "description": "The update request is malformed"
        },
        "404": {
          "description": "No active annotation with the given id exists on the Canvas"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/{save_id}/node/{data_id}": {
    "get": {
      "summary": "Get the underlying data entity for a Canvas Node",
      "description": "Returns the underlying data-pool entity (the signed SummaryNode) for a Canvas Node. The node must belong to the given Canvas and that Canvas must be owned by the current user and not trashed; otherwise the response is 404.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        },
        {
          "name": "data_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Data Node ID (the data_id of the Canvas Node)"
        }
      ],
      "responses": {
        "200": {
          "description": "The underlying data entity for the node",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/summary.json#/SummaryNode"
              }
            }
          }
        },
        "404": {
          "description": "No such node on a Canvas the current user owns"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    },
    "put": {
      "summary": "Update the display properties of a Canvas Node",
      "description": "Partially updates a single Canvas Node's display properties (label, hidden). Node position is updated through the dedicated move endpoint, not here. Returns the updated Canvas Node.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        },
        {
          "name": "data_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Data Node ID (the data_id of the Canvas Node)"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/canvas.json#/UpdateCanvasElementRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The updated Canvas Node",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/CanvasNode"
              }
            }
          }
        },
        "400": {
          "description": "The update request is malformed"
        },
        "404": {
          "description": "No active node with the given data_id exists on the canvas"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/canvas/{save_id}/edge/{data_id}": {
    "get": {
      "summary": "Get the underlying data entity for a Canvas Edge",
      "description": "Returns the underlying data-pool entity (the signed SummaryEdge) for a Canvas Edge. The edge must belong to the given Canvas and that Canvas must be owned by the current user and not trashed; otherwise the response is 404.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        },
        {
          "name": "data_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Data Edge ID (the data_id of the Canvas Edge)"
        }
      ],
      "responses": {
        "200": {
          "description": "The underlying data entity for the edge",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/summary.json#/SummaryEdge"
              }
            }
          }
        },
        "404": {
          "description": "No such edge on a Canvas the current user owns"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    },
    "put": {
      "summary": "Update the display properties of a Canvas Edge",
      "description": "Partially updates a single Canvas Edge's display properties (label, hidden). Returns the updated Canvas Edge.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "save_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Canvas Save ID"
        },
        {
          "name": "data_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The Data Edge ID (the data_id of the Canvas Edge)"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/canvas.json#/UpdateCanvasElementRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The updated Canvas Edge",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/canvas.json#/CanvasEdge"
              }
            }
          }
        },
        "400": {
          "description": "The update request is malformed"
        },
        "404": {
          "description": "No active edge with the given data_id exists on the canvas"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  }
}
