{
  "/api/v1/users/me/nodes": {
    "get": {
      "summary": "Get the User Nodes for the current User",
      "security": [
        {
          "cookieAuth": []
        },
        {
          "apiKeyAuth": []
        }
      ],
      "parameters": [
        {
          "name": "include_deleted",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          },
          "description": "Include trashed entities when true"
        }
      ],
      "responses": {
        "200": {
          "description": "The User Nodes",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "../schemas/user-entity.json#/UserNode"
                }
              }
            }
          }
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    },
    "post": {
      "summary": "Create a User Node for the current User",
      "security": [
        {
          "cookieAuth": []
        },
        {
          "apiKeyAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/user-entity.json#/CreateUserNodeRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The created User Node",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/user-entity.json#/UserNode"
              }
            }
          }
        },
        "400": {
          "description": "The request is malformed"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/nodes/trash": {
    "put": {
      "summary": "Trash a list of User Node IDs for the current User",
      "security": [
        {
          "cookieAuth": []
        },
        {
          "apiKeyAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "User Nodes trashed successfully"
        },
        "400": {
          "description": "The request body is not a valid array of User Node IDs"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/nodes/restore": {
    "put": {
      "summary": "Restore a list of User Node IDs for the current User",
      "security": [
        {
          "cookieAuth": []
        },
        {
          "apiKeyAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "User Nodes restored successfully"
        },
        "400": {
          "description": "The request body is not a valid array of User Node IDs"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
  "/api/v1/users/me/nodes/{id}": {
    "get": {
      "summary": "Get a User Node owned by the current User",
      "security": [
        {
          "cookieAuth": []
        },
        {
          "apiKeyAuth": []
        }
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The User Node ID"
        },
        {
          "name": "include_deleted",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          },
          "description": "Include trashed entities when true"
        }
      ],
      "responses": {
        "200": {
          "description": "The User Node",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/user-entity.json#/UserNode"
              }
            }
          }
        },
        "400": {
          "description": "The id is not an integer"
        },
        "404": {
          "description": "No such User Node for the current User (trashed ones are excluded unless include_deleted is true)"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    },
    "put": {
      "summary": "Update a User Node owned by the current User",
      "security": [
        {
          "cookieAuth": []
        },
        {
          "apiKeyAuth": []
        }
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "The User Node ID"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/user-entity.json#/UpdateUserNodeRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The updated User Node",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/user-entity.json#/UserNode"
              }
            }
          }
        },
        "400": {
          "description": "The update request is malformed"
        },
        "404": {
          "description": "No active User Node with the given id for the current User"
        },
        "401": {
          "description": "Authentication Required"
        },
        "500": {
          "description": "Internal Server Error"
        }
      }
    }
  },
